{
  "name": "spotdrop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Drop screenshots of food spots & activities, get a searchable, mapped database. Local-first.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"node --watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.ts",
    "app": "npm run build && npm start",
    "typecheck": "tsc --noEmit -p .",
    "service:install": "zsh scripts/install-mac-service.sh",
    "service:restart": "npm run build && launchctl kickstart -k gui/$(id -u)/com.spotdrop.app",
    "service:uninstall": "zsh scripts/uninstall-mac-service.sh",
    "service:stop": "launchctl kill TERM gui/$(id -u)/com.spotdrop.app",
    "service:start": "launchctl kickstart gui/$(id -u)/com.spotdrop.app",
    "app:mac": "zsh scripts/make-mac-app.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "express": "^5.2.1",
    "heic-convert": "^2.1.0",
    "multer": "^2.4.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "lucide-react": "^1.52.0",
    "maplibre-gl": "^6.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "wrangler": "^4.151.1"
  }
}
